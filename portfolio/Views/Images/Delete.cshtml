@model ProjectImage
@{
    ViewData["Title"] = "Delete an image";
}

<h1 class="mb-3">Delete an image</h1>

<div class="card card-body form-card" style="max-width:42rem">
    <p>Are you sure you want to delete this image of “@Model.ProjectTitle”?</p>
    <img src="@Model.ImageUrl" alt="" style="max-width:20rem" class="mb-2 rounded" />
    <p class="text-break text-muted small">@Model.ImageUrl</p>

    <form asp-action="Delete" asp-route-id="@Model.ImageId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-link">Cancel</a>
    </form>
</div>
