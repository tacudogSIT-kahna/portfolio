@model ProjectImage
@{
    ViewData["Title"] = "Edit an image";
}

<h1 class="mb-1">Edit an image</h1>
<p class="text-muted">of “@Model.ProjectTitle”</p>

<form asp-action="Edit" method="post" class="card card-body form-card" style="max-width:42rem">
    <input type="hidden" asp-for="ImageId" />
    <input type="hidden" asp-for="ProjectId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label">Image URL</label>
        <input asp-for="ImageUrl" class="form-control" placeholder="https://.../screenshot.png" />
        <div class="form-text">A public link: a Supabase Storage public URL, or a file committed to GitHub.</div>
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-urls.js" asp-append-version="true"></script>
}
