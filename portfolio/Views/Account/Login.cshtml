@{
    ViewData["Title"] = "Editor sign-in";
}

<h1 class="mb-3">Editor sign-in</h1>
<p class="text-muted">Visitors can look at the portfolio freely. Only the editor can add, change or delete.</p>

<form asp-action="Login" asp-route-returnUrl="@(ViewBag.ReturnUrl as string)" method="post"
      class="card card-body form-card" style="max-width:26rem">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input id="password" name="password" type="password" class="form-control" autocomplete="current-password" autofocus />
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Sign in</button>
        <a asp-controller="Portfolio" asp-action="Index" class="btn btn-link">Back to the portfolio</a>
    </div>
</form>