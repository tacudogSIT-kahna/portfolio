@model Project
@{
    ViewData["Title"] = "Add a project";
}

<h1 class="mb-3">Add a project</h1>

<form asp-action="Create" method="post" class="card card-body form-card" style="max-width:42rem">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

    <div class="mb-3">
        <label asp-for="CourseId" class="form-label">Course</label>
        <select asp-for="CourseId" asp-items="ViewBag.Courses" class="form-select">
            <option value="">(choose a course)</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Project title</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Summary" class="form-label"></label>
        <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Summary" class="text-danger"></span>
    </div>

        <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="StartedOn" class="form-label">Date started</label>
            <input asp-for="StartedOn" type="date" value="@(Model.StartedOn?.ToString("yyyy-MM-dd"))" class="form-control" />
            <span asp-validation-for="StartedOn" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="EndedOn" class="form-label">Date ended <span class="text-muted">(leave empty if ongoing)</span></label>
            <input asp-for="EndedOn" type="date" value="@(Model.EndedOn?.ToString("yyyy-MM-dd"))" class="form-control" />
            <span asp-validation-for="EndedOn" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="VideoUrl" class="form-label">Demo video (YouTube link)</label>
        <input asp-for="VideoUrl" class="form-control" placeholder="https://youtu.be/abcdefghijk" />
        <span asp-validation-for="VideoUrl" class="text-danger"></span>
    </div>

        <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes (private notepad)</label>
        <textarea asp-for="Notes" class="form-control notes-input" rows="6"
                  placeholder="What you learned, problems you solved, ideas to improve..."></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrls" class="form-label">Image URLs</label>
        <textarea asp-for="ImageUrls" class="form-control" rows="5"
                  placeholder="https://.../screenshot1.png&#10;https://.../screenshot2.png"></textarea>
        <div class="form-text">One public URL per line. Saved together with the project: if one fails, nothing is saved.</div>
        <span asp-validation-for="ImageUrls" class="text-danger"></span>
    </div>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/image-urls.js" asp-append-version="true"></script>
}
