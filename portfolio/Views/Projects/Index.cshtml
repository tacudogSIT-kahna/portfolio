@model List<Project>
@{
    ViewData["Title"] = "Projects (editor)";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="mb-0">Projects</h1>
        <p class="text-muted mb-0">@Model.Count projects</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add a project</a>
</div>

<table class="table table-striped table-hover align-middle">
    <thead class="table-dark">
        <tr>
            <th>Project</th>
            <th>Course</th>
            <th>Started</th><th>Ended</th>
            <th class="text-end">Images</th>
            <th>Video</th>
            <th style="width:16rem"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Title</td>
                <td><span class="code-badge">@p.CourseCode</span></td>
                <td>@(p.StartedOn?.ToString("yyyy-MM-dd"))</td>
                <td>@(p.EndedOn?.ToString("yyyy-MM-dd") ?? "Ongoing")</td>
                <td class="text-end">@p.ImageCount</td>
                <td>@(string.IsNullOrEmpty(p.VideoUrl) ? "—" : "Yes")</td>
                <td class="text-end">
                    <a asp-controller="Portfolio" asp-action="ProjectDetails" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-primary">View</a>
                    <a asp-controller="Images" asp-action="Index" asp-route-projectId="@p.ProjectId" class="btn btn-sm btn-outline-secondary">Images</a>
                    <a asp-action="Edit" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    <a asp-action="Delete" asp-route-id="@p.ProjectId" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
