@model Project
@{
    ViewData["Title"] = "Delete a project";
}

<h1 class="mb-3">Delete a project</h1>

<div class="card card-body form-card" style="max-width:38rem">
    <p>Are you sure you want to delete this project?</p>
    <dl class="row mb-2">
        <dt class="col-4">Project</dt>
        <dd class="col-8">@Model.Title</dd>
        <dt class="col-4">Course</dt>
        <dd class="col-8">@Model.CourseCode</dd>
        <dt class="col-4">Images</dt>
        <dd class="col-8">@Model.ImageCount</dd>
    </dl>
    <p class="text-muted small">Its @Model.ImageCount image(s) are deleted with it.</p>

    <form asp-action="Delete" asp-route-id="@Model.ProjectId" method="post">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>
