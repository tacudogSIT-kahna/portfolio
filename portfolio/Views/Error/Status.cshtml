@{
    int code = ViewBag.Code ?? 500;
    ViewData["Title"] = code == 404 ? "Page not found" : "Error " + code;
}

<div class="text-center py-5">
    <p class="display-1 brand-font mb-0">@code</p>
    @if (code == 404)
    {
        <h1 class="h3 mb-3">We couldn't find that page.</h1>
        <p class="text-muted">The course, project or image you asked for does not exist, or it was deleted.</p>
    }
    else if (code == 403)
    {
        <h1 class="h3 mb-3">You are not allowed to open that page.</h1>
    }
    else
    {
        <h1 class="h3 mb-3">That request could not be completed.</h1>
    }
    <a asp-controller="Portfolio" asp-action="Index" class="btn btn-primary">Back to the portfolio</a>
</div>
